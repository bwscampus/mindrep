# Copy to .env for local development. There are no secrets here: the app is
# static and keeps all of its state in the browser, so the server needs only
# enough configuration to serve it safely.

ENVIRONMENT=development

# Where the app is reachable. Must be https:// in production (API-10).
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated hostnames the server will answer to. Must not be '*' in
# production (API-10).
ALLOWED_HOSTS=*
